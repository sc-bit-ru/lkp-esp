{
  "manifest_version": 3,
  "name": "ЛК ЕСП → CRM",
  "description": "Пересылает на указанный приём JSON, который страница кабинета уже получила.",
  "version": "0.2.0",
  "minimum_chrome_version": "111",
  "action": {
    "default_title": "ЛК ЕСП → CRM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "scripting"],
  "optional_host_permissions": ["https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
